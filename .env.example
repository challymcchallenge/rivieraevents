# Variabile de mediu pentru rivieraevents.ro. Valorile reale se pun în Vercel → Settings → Environment Variables,
# NU în acest fișier și NU în repo. Toate sunt publice (NEXT_PUBLIC_*): ajung în browser, deci nu sunt secrete.

# Formularul de cerere de ofertă (ADR-006)
NEXT_PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
NEXT_PUBLIC_WEB3FORMS_KEY=

# Panoul de administrare Keystatic Cloud (ADR-002), format „echipa/proiect”.
# Gol = Keystatic lucrează local (doar pe calculatorul de dezvoltare).
NEXT_PUBLIC_KEYSTATIC_PROJECT=
